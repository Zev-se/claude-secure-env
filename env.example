# Claude Code Sandbox — Environment Configuration
# Copy this file to .env and fill in your values.

# ── Authentication (pick ONE mode) ────────────────────────────────────────────
#
# API mode (pay-per-token): uncomment and set your key, AND uncomment the
# ANTHROPIC_API_KEY line in docker-compose.yml.
#ANTHROPIC_API_KEY=sk-ant-...
#
# Subscription mode (Pro/Max): leave the above commented out and follow
# SUBSCRIPTION_MODE.md to mount your host credentials into the container.

# UID of your host user (run: id -u)
# Used to create a matching non-root user inside the container
# so that files written by the agent are owned by you on the host.
HOST_UID=1000

# Colon-separated list of host paths to mount read-write inside the container.
# Each path appears at /workspace/<basename> inside the container.
# Tilde (~) is supported.
# WARNING: Never mount directories that contain secrets, credentials,
# SSH keys, .git configs with tokens, or other sensitive data.
AGENT_MOUNTS_RW=~/code/project-a/src

# Colon-separated list of host paths to mount read-only inside the container.
# Each path appears at /workspace/<basename> inside the container.
AGENT_MOUNTS_RO=~/code/shared-lib/src
